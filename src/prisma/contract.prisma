// use prisma-next

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum VerificationType {
  EMAIL
  PHONE
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum AdmissionStatus {
  APPLIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

enum NotificationType {
  GENERAL
  ASSIGNMENT
  ATTENDANCE
  FEE
  EXAM
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum ConversationType {
  DIRECT
  GROUP
}

enum BookIssueStatus {
  ISSUED
  RETURNED
  OVERDUE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum InviteType {
  SCHOOL_ADMIN
  TEACHER
  PARENT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TwoFactorMethod {
  AUTHENTICATOR
  EMAIL
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum AIRequestType {
  CHAT
  DOUBT_SOLVER
  PERFORMANCE
  ATTENDANCE_ANOMALY
  TIMETABLE
  REPORT_SUMMARY
  RECOMMENDATION
}

model School {
  id          Int          @id @default(autoincrement())
  name        String
  email       String?      @unique
  phone       String?      @unique
  address     String?
  city        String?
  state       String?
  country     String?
  status      SchoolStatus @default(ACTIVE)

  users           User[]
  academicYears   AcademicYear[]
  campuses        Campus[]
  departments     Department[]
  classes         Class[]
  students        Student[]
  teachers        Teacher[]
  parents         Parent[]
  admissions      Admission[]
  subjects        Subject[]
  exams           Exam[]
  feeStructures   FeeStructure[]
  courses         Course[]
  notifications   Notification[]
  announcements   Announcement[]
  conversations   Conversation[]
  books           Book[]
  buses           Bus[]
  transportRoutes TransportRoute[]
  drivers         Driver[]
  hostels         Hostel[]
  employees       Employee[]
  subscriptions   Subscription[]
  supportTickets  SupportTicket[]
  settings        SchoolSetting?
  invites         Invite[]
  reportJobs      ReportJob[]
  aiRequests      AIRequest[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model User {
  id            Int      @id @default(autoincrement())
  schoolId      Int?
  userCode      String?  @unique
  email         String   @unique
  phone         String?  @unique
  username      String?  @unique
  name          String?
  password      String
  role          UserRole
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)

  school        School?                    @relation(fields: [schoolId], references: [id])
  verifications Verification[]
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]
  sentMessages  Message[]
  conversations ConversationParticipant[]
  assignments   Assignment[]               @relation("AssignmentCreator")
  sentInvites   Invite[]                   @relation("InviteSender")
  announcements Announcement[]             @relation("AnnouncementCreator")
  reportJobs    ReportJob[]
  aiRequests    AIRequest[]

  student   Student?
  teacher   Teacher?
  parent    Parent?
  twoFactor TwoFactorAuth?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Verification {
  id        Int              @id @default(autoincrement())
  userId    Int
  otp       String
  type      VerificationType
  expiresAt TimestamptzString
  verified  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Session {
  id        Int           @id @default(autoincrement())
  userId    Int
  token     String        @unique
  ipAddress String?
  userAgent String?
  status    SessionStatus @default(ACTIVE)
  expiresAt TimestamptzString

  user User @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
}

model TwoFactorAuth {
  id         Int             @id @default(autoincrement())
  userId     Int             @unique
  method     TwoFactorMethod
  secret     String?
  enabled    Boolean         @default(false)
  backupCodes String?

  user User @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String?
  entityId  Int?
  details   String?
  ipAddress String?

  user User? @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Invite {
  id         Int          @id @default(autoincrement())
  schoolId   Int
  senderId   Int
  email      String
  type       InviteType
  status     InviteStatus @default(PENDING)
  token      String       @unique
  expiresAt  TimestamptzString
  acceptedAt TimestamptzString?

  school School @relation(fields: [schoolId], references: [id])
  sender User   @relation("InviteSender", fields: [senderId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model AcademicYear {
  id         Int      @id @default(autoincrement())
  schoolId   Int
  name       String
  startDate  TimestamptzString
  endDate    TimestamptzString
  isCurrent  Boolean  @default(false)

  school  School  @relation(fields: [schoolId], references: [id])
  classes Class[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Campus {
  id        Int     @id @default(autoincrement())
  schoolId  Int
  name      String
  code      String
  address   String?
  city      String?
  state     String?
  country   String?

  school School @relation(fields: [schoolId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Department {
  id          Int     @id @default(autoincrement())
  schoolId    Int
  name        String
  code        String
  description String?

  school    School     @relation(fields: [schoolId], references: [id])
  teachers  Teacher[]
  subjects  Subject[]
  employees Employee[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Class {
  id             Int @id @default(autoincrement())
  schoolId       Int
  academicYearId Int
  name           String
  code           String?

  school        School       @relation(fields: [schoolId], references: [id])
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id])
  sections      Section[]
  students      Student[]
  timetable     Timetable[]
  attendance    Attendance[]
  classSubjects ClassSubject[]
  courses       Course[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Section {
  id      Int     @id @default(autoincrement())
  classId Int
  name    String
  code    String?

  class      Class        @relation(fields: [classId], references: [id])
  students   Student[]
  timetable  Timetable[]
  attendance Attendance[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Subject {
  id           Int     @id @default(autoincrement())
  schoolId     Int
  departmentId Int?
  name         String
  code         String
  description  String?

  school          School          @relation(fields: [schoolId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])
  classSubjects   ClassSubject[]
  teacherSubjects TeacherSubject[]
  examSubjects    ExamSubject[]
  questions       Question[]
  timetable       Timetable[]
  courses         Course[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ClassSubject {
  id        Int @id @default(autoincrement())
  classId   Int
  subjectId Int

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Student {
  id           Int     @id @default(autoincrement())
  schoolId     Int
  userId       Int?    @unique
  classId      Int?
  sectionId    Int?
  admissionNo  String  @unique
  rollNumber   String?
  dateOfBirth  TimestamptzString?
  gender       String?
  bloodGroup   String?
  address      String?
  city         String?
  state        String?
  country      String?
  status       String?

  school            School              @relation(fields: [schoolId], references: [id])
  user              User?               @relation(fields: [userId], references: [id])
  class             Class?              @relation(fields: [classId], references: [id])
  section           Section?            @relation(fields: [sectionId], references: [id])
  profile           StudentProfile?
  documents         StudentDocument[]
  attendances       Attendance[]
  results           Result[]
  studentFees       StudentFee[]
  admissions        Admission[]
  parents           ParentStudent[]
  submissions       AssignmentSubmission[]
  examAttempts      ExamAttempt[]
  libraryIssues     BookIssue[]
  hostelAllocations HostelAllocation[]
  busAttendances    BusAttendance[]
  enrollments       CourseEnrollment[]
  medicalRecords    StudentMedicalRecord[]
  disciplinaryRecords StudentDisciplinaryRecord[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model StudentProfile {
  id             Int    @id @default(autoincrement())
  studentId      Int    @unique
  fatherName     String?
  motherName     String?
  guardianName   String?
  guardianPhone  String?
  emergencyPhone String?

  student Student @relation(fields: [studentId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model StudentDocument {
  id           Int    @id @default(autoincrement())
  studentId    Int
  name         String
  documentType String?
  fileUrl      String
  fileType     String?

  student Student @relation(fields: [studentId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Admission {
  id            Int             @id @default(autoincrement())
  schoolId      Int
  studentId     Int?
  applicationNo String          @unique
  name          String
  email         String?
  phone         String?
  classId       Int?
  status        AdmissionStatus @default(APPLIED)
  notes         String?

  school  School   @relation(fields: [schoolId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Teacher {
  id            Int    @id @default(autoincrement())
  schoolId      Int
  userId        Int?   @unique
  departmentId  Int?
  employeeNo    String @unique
  joiningDate   TimestamptzString?
  qualification String?
  designation   String?

  school          School           @relation(fields: [schoolId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  teacherSubjects TeacherSubject[]
  timetable       Timetable[]
  attendances     TeacherAttendance[]
  assignments     Assignment[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model TeacherSubject {
  id        Int @id @default(autoincrement())
  teacherId Int
  subjectId Int

  teacher Teacher @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Timetable {
  id        Int    @id @default(autoincrement())
  schoolId  Int
  classId   Int
  sectionId Int?
  teacherId Int?
  subjectId Int
  day       String
  startTime String
  endTime   String
  room      String?

  class   Class    @relation(fields: [classId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])
  subject Subject  @relation(fields: [subjectId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  classId   Int
  sectionId Int?
  date      TimestamptzString
  status    AttendanceStatus
  remarks   String?
  method    String?
  deviceId  String?
  latitude  Float?
  longitude Float?

  student Student  @relation(fields: [studentId], references: [id])
  class   Class    @relation(fields: [classId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model TeacherAttendance {
  id        Int              @id @default(autoincrement())
  teacherId Int
  date      TimestamptzString
  status    AttendanceStatus
  remarks   String?
  method    String?

  teacher Teacher @relation(fields: [teacherId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Exam {
  id          Int         @id @default(autoincrement())
  schoolId    Int
  name        String
  description String?
  startDate   TimestamptzString?
  endDate     TimestamptzString?
  status      ExamStatus  @default(DRAFT)

  school    School        @relation(fields: [schoolId], references: [id])
  subjects  ExamSubject[]
  questions Question[]
  attempts  ExamAttempt[]
  results   Result[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ExamSubject {
  id        Int @id @default(autoincrement())
  examId    Int
  subjectId Int
  maxMarks  Int
  passMarks Int

  exam    Exam    @relation(fields: [examId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Question {
  id        Int          @id @default(autoincrement())
  examId    Int
  subjectId Int
  question  String
  type      QuestionType
  marks     Int
  options   String?
  answer    String?

  exam    Exam        @relation(fields: [examId], references: [id])
  subject Subject     @relation(fields: [subjectId], references: [id])
  answers ExamAnswer[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ExamAttempt {
  id          Int              @id @default(autoincrement())
  examId      Int
  studentId   Int
  startedAt   TimestamptzString
  submittedAt TimestamptzString?

  exam    Exam        @relation(fields: [examId], references: [id])
  student Student     @relation(fields: [studentId], references: [id])
  answers ExamAnswer[]

  createdAt TimestamptzString @default(now())
}

model ExamAnswer {
  id         Int    @id @default(autoincrement())
  attemptId  Int
  questionId Int
  answer     String?
  marks      Int?

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Result {
  id        Int    @id @default(autoincrement())
  examId    Int
  studentId Int
  subjectId Int?
  marks     Int
  grade     String?
  remarks   String?
  rank      Int?

  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model FeeStructure {
  id          Int    @id @default(autoincrement())
  schoolId    Int
  name        String
  amount      Int
  description String?
  frequency   String?

  school      School      @relation(fields: [schoolId], references: [id])
  studentFees StudentFee[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model StudentFee {
  id           Int       @id @default(autoincrement())
  studentId    Int
  feeStructureId Int
  amount       Int
  paidAmount   Int       @default(0)
  dueDate      TimestamptzString?
  status       FeeStatus @default(PENDING)
  discount     Int       @default(0)
  scholarship  Int       @default(0)
  lateFee      Int       @default(0)

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     Payment[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Payment {
  id              Int           @id @default(autoincrement())
  studentFeeId    Int?
  amount          Int
  transactionId   String?       @unique
  status          PaymentStatus @default(PENDING)
  gateway         String?
  gatewayOrderId  String?
  gatewayPaymentId String?
  receiptUrl      String?

  studentFee StudentFee? @relation(fields: [studentFeeId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Assignment {
  id          Int              @id @default(autoincrement())
  schoolId    Int
  teacherId   Int
  creatorId   Int?
  classId     Int?
  subjectId   Int?
  title       String
  description String?
  dueDate     TimestamptzString?
  status      AssignmentStatus @default(DRAFT)

  teacher     Teacher               @relation(fields: [teacherId], references: [id])
  creator     User?                 @relation("AssignmentCreator", fields: [creatorId], references: [id])
  submissions AssignmentSubmission[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model AssignmentSubmission {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  content      String?
  fileUrl      String?
  marks        Int?
  feedback     String?
  status       SubmissionStatus @default(PENDING)
  submittedAt  TimestamptzString?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Parent {
  id         Int    @id @default(autoincrement())
  schoolId   Int
  userId     Int    @unique
  occupation String?
  address    String?

  school   School         @relation(fields: [schoolId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  students ParentStudent[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ParentStudent {
  id        Int    @id @default(autoincrement())
  parentId  Int
  studentId Int
  relation  String

  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Course {
  id          Int          @id @default(autoincrement())
  schoolId    Int
  classId     Int?
  subjectId   Int?
  teacherId   Int?
  title       String
  description String?
  thumbnail   String?
  status      CourseStatus @default(DRAFT)

  school      School            @relation(fields: [schoolId], references: [id])
  class       Class?            @relation(fields: [classId], references: [id])
  subject     Subject?          @relation(fields: [subjectId], references: [id])
  lessons     Lesson[]
  quizzes     Quiz[]
  enrollments CourseEnrollment[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Lesson {
  id          Int     @id @default(autoincrement())
  courseId    Int
  title       String
  description String?
  videoUrl    String?
  duration    Int?
  position    Int
  isPublished Boolean @default(false)

  course    Course           @relation(fields: [courseId], references: [id])
  resources CourseResource[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model CourseResource {
  id        Int    @id @default(autoincrement())
  lessonId  Int
  name      String
  fileUrl   String
  fileType  String?

  lesson Lesson @relation(fields: [lessonId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Quiz {
  id          Int         @id @default(autoincrement())
  courseId    Int
  title       String
  description String?
  status      QuizStatus  @default(DRAFT)
  duration    Int?
  totalMarks  Int?

  course    Course         @relation(fields: [courseId], references: [id])
  questions QuizQuestion[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model QuizQuestion {
  id       Int    @id @default(autoincrement())
  quizId   Int
  question String
  options  String?
  answer   String?
  marks    Int

  quiz Quiz @relation(fields: [quizId], references: [id])

  createdAt TimestamptzString @default(now())
}

model CourseEnrollment {
  id          Int              @id @default(autoincrement())
  courseId    Int
  studentId   Int
  status      EnrollmentStatus @default(ACTIVE)
  progress    Int              @default(0)
  enrolledAt  TimestamptzString
  completedAt TimestamptzString?

  course  Course  @relation(fields: [courseId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Notification {
  id        Int                  @id @default(autoincrement())
  schoolId  Int
  userId    Int
  title     String
  message   String
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean              @default(false)

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Announcement {
  id          Int    @id @default(autoincrement())
  schoolId    Int
  creatorId   Int
  title       String
  message     String
  targetRole  UserRole?
  isEmergency Boolean @default(false)
  isPublished Boolean @default(false)
  publishAt   TimestamptzString?

  school  School @relation(fields: [schoolId], references: [id])
  creator User   @relation("AnnouncementCreator", fields: [creatorId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Conversation {
  id        Int              @id @default(autoincrement())
  schoolId  Int
  title     String?
  type      ConversationType @default(DIRECT)

  school       School                   @relation(fields: [schoolId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ConversationParticipant {
  id             Int @id @default(autoincrement())
  conversationId Int
  userId         Int

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Message {
  id             Int    @id @default(autoincrement())
  conversationId Int
  senderId       Int
  message        String
  attachmentUrl  String?
  messageType    String?

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Book {
